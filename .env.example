MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Local legacy PHP/MySQL source used only by the migration command.
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=house_rent_manager
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
# Defaults to ..\uploads relative to this project folder.
LEGACY_UPLOADS_DIR=
